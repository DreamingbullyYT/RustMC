diff --git a/crates/horizon-client-render/src/auth.rs b/crates/horizon-client-render/src/auth.rs
--- a/crates/horizon-client-render/src/auth.rs
+++ b/crates/horizon-client-render/src/auth.rs
@@ -126,9 +126,27 @@
 static CURRENT: OnceLock<Arc<AuthSession>> = OnceLock::new();
+#[cfg(target_os = "android")]
+static ANDROID_CURRENT: std::sync::RwLock<Option<Arc<AuthSession>>> = std::sync::RwLock::new(None);
 
 /// The account this game was started with (set once at start).
 pub fn set_current(session: AuthSession) {
+    #[cfg(not(target_os = "android"))]
     let _ = CURRENT.set(Arc::new(session));
+    #[cfg(target_os = "android")]
+    {
+        *ANDROID_CURRENT.write().unwrap() = Some(Arc::new(session));
+    }
 }
 pub fn current() -> Option<Arc<AuthSession>> {
+    #[cfg(not(target_os = "android"))]
+    {
+        CURRENT.get().cloned()
+    }
+    #[cfg(target_os = "android")]
+    {
+        ANDROID_CURRENT.read().unwrap().clone()
+    }
+}
+
+/// Clear the in-process account when the Android launcher signs out or switches accounts.
+#[cfg(target_os = "android")]
+pub fn clear_current() {
+    *ANDROID_CURRENT.write().unwrap() = None;
 }
